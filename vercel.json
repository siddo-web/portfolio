      "permanent": true
    },
    {
      "source": "/services/webflow-wix-development",
      "destination": "/webflow/",
      "permanent": true
    },
    {
      "source": "/services/webflow-wix-development/",
      "destination": "/webflow/",
      "permanent": true
    },
    {
      "source": "/services/cms-migration-integration",
