{
  "version": 2,
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/content/projects.json",
      "destination": "/api/projects"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://raw.githubusercontent.com data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/webdev_portfolio",
      "destination": "/wordpress/",
      "permanent": true
    },
    {
      "source": "/webdev_portfolio/",
      "destination": "/wordpress/",
      "permanent": true
    },
    {
      "source": "/UIUX_portfolio",
      "destination": "/shopify/",
      "permanent": true
    },
    {
      "source": "/UIUX_portfolio/",
      "destination": "/shopify/",
      "permanent": true
    },
    {
      "source": "/graphic",
      "destination": "/webflow/",
      "permanent": true
    },
    {
      "source": "/graphic/",
      "destination": "/webflow/",
      "permanent": true
    },
    {
      "source": "/appdev_portfolio",
      "destination": "/wix/",
      "permanent": true
    },
    {
      "source": "/appdev_portfolio/",
      "destination": "/wix/",
      "permanent": true
    },
    {
      "source": "/digital-marketing",
      "destination": "/other-cms/",
      "permanent": true
    },
    {
      "source": "/digital-marketing/",
      "destination": "/other-cms/",
      "permanent": true
    },
    {
      "source": "/services/wordpress-development",
      "destination": "/wordpress/",
      "permanent": true
    },
    {
      "source": "/services/wordpress-development/",
      "destination": "/wordpress/",
      "permanent": true
    },
    {
      "source": "/services/shopify-development",
      "destination": "/shopify/",
      "permanent": true
    },
    {
