# Put actual secrets only in Vercel Project Settings → Environment Variables.
# DO NOT commit or publish a real .env file or credentials.
GITHUB_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPO=YOUR_REPOSITORY_NAME
GITHUB_BRANCH=main
GITHUB_TOKEN=SET_IN_VERCEL_ONLY
ADMIN_PASSWORD=SET_A_STRONG_12_PLUS_CHAR_PASSWORD_IN_VERCEL
SESSION_SECRET=GENERATE_A_RANDOM_32_PLUS_CHAR_SECRET_IN_VERCEL

# Recommended: primary HTTPS domain, e.g. https://yourportfolio.com
SITE_URL=https://YOUR-DOMAIN.example

# Optional distributed rate limiting for CMS login (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
